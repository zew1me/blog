# Adapted from github/gitignore (Node, Global/macOS, Global/Windows,
# Global/Linux) plus the Astro/Vercel specifics this repo actually uses.
#
# NOTE: pnpm-lock.yaml is deliberately NOT ignored. It pins the dependency tree
# Vercel builds from — including TypeScript 6.x, which `astro check` requires.

# --- Build output -----------------------------------------------------------
dist/
.output/

# --- Generated types --------------------------------------------------------
.astro/
*.tsbuildinfo

# --- Deploy -----------------------------------------------------------------
.vercel/

# --- Dependencies -----------------------------------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.*

# --- Package manager caches and state ---------------------------------------
.npm
.pnpm-store/
.eslintcache
.stylelintcache
.cache/
.parcel-cache/

# --- Logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Diagnostic reports -----------------------------------------------------
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Test coverage ----------------------------------------------------------
coverage/
*.lcov
.nyc_output/

# --- Environment ------------------------------------------------------------
.env
.env.*
!.env.example

# --- Local tooling ----------------------------------------------------------
.pi/
.serena/

# --- Editors ----------------------------------------------------------------
# .vscode is partially tracked (extensions.json, launch.json), so ignore the
# rest of it rather than the whole directory.
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*.sublime-workspace

# --- macOS ------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# --- Windows ----------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Linux ------------------------------------------------------------------
*~
.directory
.Trash-*
