---
import PostListItem from '../components/PostListItem.astro';
import { HOME_POST_COUNT, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/content.ts';

const posts = await getPublishedPosts();
const recent = posts.slice(0, HOME_POST_COUNT);
const hasMore = posts.length > recent.length;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="measure landing">
		<section class="hero" aria-labelledby="hello-heading">
			<p class="eyebrow">Welcome</p>
			<h1 id="hello-heading">Hello, world.</h1>
			<p class="intro">{SITE_DESCRIPTION}</p>
			<div class="actions">
				<a class="primary-action" href="/posts/">Read the posts <span aria-hidden="true">→</span></a
				>
				<a href="/rss.xml">Follow by RSS</a>
			</div>
		</section>

		<section class="latest" aria-labelledby="latest-heading">
			<div class="section-header">
				<h2 id="latest-heading">Latest writing</h2>
				{
					hasMore && (
						<a href="/posts/">
							Full archive <span aria-hidden="true">→</span>
						</a>
					)
				}
			</div>

			{
				recent.length > 0 ? (
					recent.map((post, index) => <PostListItem post={post} featured={index === 0} />)
				) : (
					<p class="empty">The first post is on its way.</p>
				)
			}
		</section>
	</div>
</BaseLayout>

<style>
	.landing {
		padding-block: 1rem 3rem;
	}

	.hero {
		padding-block: 4rem 4.5rem;
		border-bottom: 1px solid var(--color-rule);
	}

	.hero .eyebrow {
		margin: 0 0 0.75rem;
	}

	h1 {
		max-width: 12ch;
		margin: 0;
		font-size: var(--text-step-4);
		line-height: 1.05;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.intro {
		max-width: 42ch;
		margin: 1.25rem 0 0;
		font-size: var(--text-step-1);
		line-height: 1.5;
		color: var(--color-ink-muted);
		text-wrap: pretty;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.8rem 1.25rem;
		margin-top: 2rem;
	}

	.actions a,
	.section-header a {
		color: var(--color-accent);
		text-underline-offset: 0.18em;
	}

	.actions .primary-action {
		display: inline-flex;
		gap: 0.45rem;
		padding: 0.65rem 0.9rem;
		border: 1px solid var(--color-accent);
		border-radius: var(--radius-sm);
		text-decoration: none;
	}

	.actions .primary-action:hover {
		background: var(--color-accent-soft);
	}

	.latest {
		padding-top: 3rem;
	}

	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	.section-header h2 {
		margin: 0;
		font-size: var(--text-step-1);
		line-height: 1.2;
	}

	.section-header a {
		font-size: var(--text-step--1);
	}

	.empty {
		color: var(--color-ink-muted);
	}

	@media (width <= 34rem) {
		.hero {
			padding-block: 3rem;
		}
	}
</style>
