---
import PostListItem from '../components/PostListItem.astro';
import { HOME_POST_COUNT, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/content.ts';

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;
const recent = rest.slice(0, HOME_POST_COUNT);
const hasMore = rest.length > recent.length;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="measure">
		<p class="intro">{SITE_DESCRIPTION}</p>

		{
			featured ? (
				<>
					<PostListItem post={featured} featured />

					{recent.length > 0 && (
						<>
							<h2 class="eyebrow section-heading">More posts</h2>
							{recent.map((post) => (
								<PostListItem post={post} />
							))}
						</>
					)}

					{hasMore && (
						<p class="more">
							<a href="/posts/">Browse the full archive →</a>
						</p>
					)}
				</>
			) : (
				<p class="empty">
					Nothing published yet. Add a Markdown file to <code>src/content/posts/</code> to get
					started — see the README.
				</p>
			)
		}
	</div>
</BaseLayout>

<style>
	.intro {
		margin: 0 0 2.5rem;
		font-size: var(--text-step-1);
		line-height: 1.5;
		color: var(--color-ink-muted);
		text-wrap: pretty;
	}

	.section-heading {
		margin: 2.75rem 0 0.25rem;
	}

	.more {
		margin-top: 1.75rem;
	}

	.more a {
		color: var(--color-accent);
		text-underline-offset: 0.18em;
	}

	.empty {
		color: var(--color-ink-muted);
	}

	.empty code {
		font-family: var(--font-mono);
		font-size: 0.9em;
	}
</style>
