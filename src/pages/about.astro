---
import { HOME_URL, SITE_AUTHOR, SOCIAL_LINKS } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description={`About ${SITE_AUTHOR} and this blog.`}>
	<div class="measure">
		<h1>About</h1>

		{/* TODO: replace this placeholder with real copy. */}
		<div class="prose">
			<p>
				I'm {SITE_AUTHOR}. This is where I write things down — mostly about software and systems,
				sometimes about whatever else has my attention.
			</p>
			<p>
				Posts are plain Markdown in a Git repository. Some of them embed small interactive pieces
				where a diagram would not have been enough.
			</p>
			<p>
				You can find me at <a href={HOME_URL}>{HOME_URL.replace('https://', '')}</a>, or on{' '}
				{
					SOCIAL_LINKS.map((link, i) => (
						<>
							{i > 0 && ', '}
							<a href={link.href} rel="me noopener">
								{link.label}
							</a>
						</>
					))
				}.
			</p>
			<p>
				The feed lives at <a href="/rss.xml">/rss.xml</a>.
			</p>
		</div>
	</div>
</BaseLayout>

<style>
	h1 {
		margin: 0 0 1.5rem;
		font-size: var(--text-step-3);
		line-height: 1.15;
		letter-spacing: -0.02em;
	}
</style>
