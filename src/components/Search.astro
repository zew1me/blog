---
// Minimal UI over the Pagefind JS API rather than Pagefind's default widget,
// so search inherits the site's design tokens.
//
// IMPORTANT: /pagefind/pagefind.js does not exist until `pagefind --site dist`
// has run, which happens in `pnpm build`. It is therefore absent in `astro dev`
// and the UI degrades to an explanatory message. See ARCHITECTURE.md.
//
// The directory is `pagefind`, not `_pagefind` — Pagefind v1.5 dropped the
// underscore. Astro would also refuse to serve an underscore-prefixed dir.
---

<div class="search" data-search>
	<label class="sr-only" for="search-input">Search posts</label>
	<input
		id="search-input"
		type="search"
		placeholder="Search posts…"
		autocomplete="off"
		spellcheck="false"
		data-search-input
	/>

	<p class="status" role="status" aria-live="polite" data-search-status></p>
	<ol class="results" data-search-results></ol>
</div>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	input {
		width: 100%;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--color-rule);
		border-radius: var(--radius-md);
		background: var(--color-paper-sunk);
		color: var(--color-ink);
		font: inherit;
		font-size: var(--text-step-0);
	}

	input::placeholder {
		color: var(--color-ink-faint);
	}

	.status {
		margin: 0.9rem 0 0;
		font-size: var(--text-step--1);
		color: var(--color-ink-faint);
	}

	.status:empty {
		display: none;
	}

	.results {
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.results :global(li) {
		padding-block: 1.15rem;
		border-bottom: 1px solid var(--color-rule);
	}

	.results :global(h2) {
		margin: 0 0 0.3rem;
		font-size: var(--text-step-1);
		line-height: 1.25;
		letter-spacing: -0.015em;
	}

	.results :global(h2 a) {
		color: var(--color-ink);
		text-decoration: none;
	}

	.results :global(h2 a:hover) {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.results :global(p) {
		margin: 0;
		font-size: var(--text-step--1);
		line-height: 1.55;
		color: var(--color-ink-muted);
	}

	/* Pagefind wraps matched terms in <mark>. */
	.results :global(mark) {
		padding: 0 0.15em;
		border-radius: var(--radius-sm);
		background: var(--color-accent-soft);
		color: var(--color-ink);
	}
</style>

<script>
	interface PagefindResultData {
		url: string;
		excerpt: string;
		meta: { title?: string };
	}
	interface PagefindResult {
		data: () => Promise<PagefindResultData>;
	}
	interface Pagefind {
		search: (query: string) => Promise<{ results: PagefindResult[] }>;
		init?: () => Promise<void>;
	}

	/**
	 * Held in a variable rather than written inline. A literal specifier would
	 * make TypeScript try to resolve a file that does not exist until Pagefind
	 * runs, failing `astro check` with ts(2307); a non-literal specifier is
	 * opaque to it. The @vite-ignore comment likewise stops Vite resolving it.
	 */
	const PAGEFIND_URL = '/pagefind/pagefind.js';

	const root = document.querySelector<HTMLElement>('[data-search]');
	const input = root?.querySelector<HTMLInputElement>('[data-search-input]');
	const status = root?.querySelector<HTMLElement>('[data-search-status]');
	const list = root?.querySelector<HTMLOListElement>('[data-search-results]');

	if (input && status && list) {
		let pagefind: Pagefind | null = null;
		let loadFailed = false;

		// @vite-ignore stops Vite trying to resolve a path that only exists in
		// the built output. Without it the build fails on a missing module.
		async function loadPagefind(): Promise<Pagefind | null> {
			if (pagefind || loadFailed) return pagefind;
			try {
				const mod = (await import(/* @vite-ignore */ PAGEFIND_URL)) as Pagefind;
				await mod.init?.();
				pagefind = mod;
			} catch {
				loadFailed = true;
				status!.textContent =
					'Search index unavailable. It is generated by `pnpm build`, so search only works against a production build (`pnpm preview`).';
			}
			return pagefind;
		}

		function escapeHtml(value: string): string {
			return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
		}

		async function runSearch(query: string): Promise<void> {
			if (!query.trim()) {
				list!.innerHTML = '';
				status!.textContent = '';
				return;
			}

			const api = await loadPagefind();
			if (!api) return;

			status!.textContent = 'Searching…';
			const search = await api.search(query);

			// Only the first 20 are rendered; each needs an async data() fetch.
			const shown = search.results.slice(0, 20);
			const data = await Promise.all(shown.map((r) => r.data()));

			if (data.length === 0) {
				list!.innerHTML = '';
				status!.textContent = `No results for “${query}”.`;
				return;
			}

			const total = search.results.length;
			status!.textContent =
				total > shown.length
					? `${total} results — showing the first ${shown.length}.`
					: `${total} result${total === 1 ? '' : 's'}.`;

			// Excerpts come from Pagefind already containing <mark> tags, so they
			// are inserted as HTML. Titles are escaped — they are author-authored
			// but there is no reason for them to carry markup.
			list!.innerHTML = data
				.map(
					(item) => `
						<li>
							<h2><a href="${item.url}">${escapeHtml(item.meta.title ?? 'Untitled')}</a></h2>
							<p>${item.excerpt}</p>
						</li>`,
				)
				.join('');
		}

		let timer: number | undefined;
		input.addEventListener('input', () => {
			window.clearTimeout(timer);
			timer = window.setTimeout(() => void runSearch(input.value), 150);
		});

		// Support deep links like /search/?q=astro
		const initial = new URLSearchParams(window.location.search).get('q');
		if (initial) {
			input.value = initial;
			void runSearch(initial);
		}
		input.focus();
	}
</script>
