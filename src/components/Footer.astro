---
import { HOME_URL, SITE_AUTHOR, SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="measure footer-inner">
		<p class="colophon">
			&copy; {year}
			<a href={HOME_URL}>{SITE_AUTHOR}</a>
		</p>

		<nav aria-label="Elsewhere">
			<ul>
				{
					SOCIAL_LINKS.map((link) => (
						<li>
							<a href={link.href} rel="me noopener">
								{link.label}
							</a>
						</li>
					))
				}
				<li><a href="/rss.xml">RSS</a></li>
			</ul>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 5rem;
		padding-block: 2rem;
		border-top: 1px solid var(--color-rule);
		font-size: var(--text-step--1);
		color: var(--color-ink-muted);
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}

	.colophon {
		margin: 0;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1.1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		color: inherit;
		text-decoration-color: var(--color-rule);
		text-underline-offset: 0.18em;
	}

	a:hover {
		color: var(--color-ink);
		text-decoration-color: currentcolor;
	}
</style>
