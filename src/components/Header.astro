---
import { NAV_LINKS, SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;

/** Home is exact-match; everything else matches its whole section. */
function isActive(href: string): boolean {
	if (href === '/') return path === '/';
	return path === href || path.startsWith(href);
}
---

<header class="site-header">
	<div class="measure header-inner">
		<a href="/" class="wordmark">{SITE_TITLE}</a>

		<nav aria-label="Primary">
			<ul>
				{
					NAV_LINKS.map((link) => (
						<li>
							<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<ThemeToggle />
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: color-mix(in oklab, var(--color-paper) 88%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--color-rule);
	}

	.header-inner {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-height: 3.5rem;
	}

	.wordmark {
		font-weight: 700;
		letter-spacing: -0.02em;
		text-decoration: none;
		color: var(--color-ink);
		white-space: nowrap;
	}

	nav {
		margin-inline-start: auto;
	}

	ul {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		font-size: var(--text-step--1);
		text-decoration: none;
		color: var(--color-ink-muted);
	}

	nav a:hover {
		color: var(--color-ink);
	}

	nav a[aria-current='page'] {
		color: var(--color-ink);
		font-weight: 700;
	}

	@media (width <= 34rem) {
		.header-inner {
			flex-wrap: wrap;
			padding-block: 0.6rem;
		}

		nav {
			order: 3;
			width: 100%;
			margin-inline-start: 0;
		}

		ul {
			gap: 0.9rem;
		}
	}
</style>
